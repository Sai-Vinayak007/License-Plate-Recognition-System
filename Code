# ── 3. TRAIN / VAL SPLIT (with shuffle) ─────────────────────
import os
import shutil
import random

random.seed(42)  # Reproducible splits

dirs = [
    'datasets/license_plates/images/train',
    'datasets/license_plates/images/val',
    'datasets/license_plates/labels/train',
    'datasets/license_plates/labels/val',
]
for d in dirs:
    os.makedirs(d, exist_ok=True)

source_images_dir = 'images'
source_labels_dir = 'labels'

image_files = [
    f for f in os.listdir(source_images_dir)
    if os.path.isfile(os.path.join(source_images_dir, f))
]
label_files = set(os.listdir(source_labels_dir))

# ✅ Shuffle before splitting to avoid ordering bias
random.shuffle(image_files)

split_index = int(len(image_files) * 0.8)
train_images = image_files[:split_index]
val_images   = image_files[split_index:]

def move_files(file_list, src_img, src_lbl, dst_img, dst_lbl):
    for img_file in file_list:
        shutil.move(os.path.join(src_img, img_file), os.path.join(dst_img, img_file))
        label_file = os.path.splitext(img_file)[0] + '.txt'
        if label_file in label_files:
            shutil.move(os.path.join(src_lbl, label_file), os.path.join(dst_lbl, label_file))

move_files(train_images, source_images_dir, source_labels_dir,
           'datasets/license_plates/images/train',
           'datasets/license_plates/labels/train')

move_files(val_images, source_images_dir, source_labels_dir,
           'datasets/license_plates/images/val',
           'datasets/license_plates/labels/val')

print(f"Train images : {len(train_images)}")
print(f"Val   images : {len(val_images)}")

