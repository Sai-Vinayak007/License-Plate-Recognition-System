# ── 5. TRAIN YOLOv8 ──────────────────────────────────────────
from ultralytics import YOLO

# ✅ Using yolov8s (small) instead of nano for better accuracy
model = YOLO('yolov8s.pt')

results = model.train(
    data='license_plate.yaml',
    epochs=50,
    imgsz=640,
    batch=16,
    name='lp_detector',
    exist_ok=True,
)

