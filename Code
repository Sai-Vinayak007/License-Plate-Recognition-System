import os
import re
import csv
import shutil
import random
import zipfile
import numpy as np
import cv2
from pathlib import Path



def setup_kaggle():
    kaggle_dir = Path.home() / ".kaggle"
    kaggle_dir.mkdir(exist_ok=True)

    kaggle_json = Path("kaggle.json")
    target = kaggle_dir / "kaggle.json"

    if kaggle_json.exists() and not target.exists():
        shutil.copy(kaggle_json, target)
        target.chmod(0o600)
        print("kaggle.json moved to ~/.kaggle/")
    elif target.exists():
        print("kaggle.json already in ~/.kaggle/")
    else:
        raise FileNotFoundError(
            "kaggle.json not found!\n"
            "Download it from https://www.kaggle.com/account "
            "and place it in the project root folder."
        )


def download_dataset():
    zip_name = "indian-license-plates-with-labels.zip"

    if not Path(zip_name).exists():
        print("Downloading dataset from Kaggle...")
        try:
            from kaggle.api.kaggle_api_extended import KaggleApi
            api = KaggleApi()
            api.authenticate()
            api.dataset_download_files(
                "kedarsai/indian-license-plates-with-labels",
                path=".",
                unzip=False
            )
            print("Dataset downloaded.")
        except ImportError:
            raise ImportError(
                "kaggle package not found.\n"
                "Run:  pip install kaggle"
            )
        except Exception as e:
            raise RuntimeError(
                f"Kaggle download failed: {e}\n\n"
                "Make sure kaggle.json is in C:\\Users\\<you>\\.kaggle\\kaggle.json"
            )
    else:
        print("Dataset zip already exists, skipping download.")

    if not Path("images").exists():
        print("Unzipping dataset...")
        with zipfile.ZipFile(zip_name, "r") as zf:
            zf.extractall(".")
        print("Unzipped successfully.")
    else:
        print("Dataset already unzipped.")



def prepare_dataset(split_ratio: float = 0.8):
    dirs = [
        "datasets/license_plates/images/train",
        "datasets/license_plates/images/val",
        "datasets/license_plates/labels/train",
        "datasets/license_plates/labels/val",
    ]
    for d in dirs:
        os.makedirs(d, exist_ok=True)

    source_images = Path("images")
    source_labels = Path("labels")

    image_files = [
        f for f in os.listdir(source_images)
        if Path(source_images / f).is_file()
    ]
    label_files = set(os.listdir(source_labels))
    random.seed(42)
    random.shuffle(image_files)

    split_idx   = int(len(image_files) * split_ratio)
    train_imgs  = image_files[:split_idx]
    val_imgs    = image_files[split_idx:]

    def copy_files(img_list, img_dest, lbl_dest):
        for img_file in img_list:
            src_img = source_images / img_file
            dst_img = Path(img_dest) / img_file
            if src_img.exists() and not dst_img.exists():
                shutil.copy(src_img, dst_img)

            lbl_file = Path(img_file).stem + ".txt"
            src_lbl  = source_labels / lbl_file
            dst_lbl  = Path(lbl_dest) / lbl_file
            if lbl_file in label_files and not dst_lbl.exists():
                shutil.copy(src_lbl, dst_lbl)

    copy_files(
        train_imgs,
        "datasets/license_plates/images/train",
        "datasets/license_plates/labels/train"
    )
    copy_files(
        val_imgs,
        "datasets/license_plates/images/val",
        "datasets/license_plates/labels/val"
    )

    print(f"Dataset split: {len(train_imgs)} train / {len(val_imgs)} val")
    yaml_content = """\
path: datasets/license_plates
train: images/train
val: images/val
nc: 1
names: ['license_plate']
"""
    with open("license_plate.yaml", "w") as f:
        f.write(yaml_content)
    print("license_plate.yaml created.")



def train_model(epochs: int = 50, imgsz: int = 640, batch: int = 16):
    from ultralytics import YOLO

    print("\nStarting training...")
    model = YOLO("yolov8s.pt")

    model.train(
        data="license_plate.yaml",
        epochs=epochs,
        imgsz=imgsz,
        batch=batch,
        augment=True,           
        project="runs/detect",
        name="train",
        device='0',
        workers=2,        
        cache=False,
        save_period=10,
        exist_ok=True
    )
    print("Training complete.")
    print("   Best weights saved to: runs/detect/train/weights/best.pt")
    return model



def validate_model(model):
    print("\nValidating model...")
    metrics = model.val()

    print("\n── Validation Metrics ──────────────────")
    print(f"  mAP50-95 : {metrics.box.map:.4f}")
    print(f"  mAP50    : {metrics.box.map50:.4f}")
    print(f"  mAP75    : {metrics.box.map75:.4f}")
    print("────────────────────────────────────────")
    return metrics


def clean_ocr_text(raw_text: str) -> str:
    text = raw_text.upper()
    text = re.sub(r'[^A-Z0-9 ]', '', text)    
    text = re.sub(r'\s+', ' ', text).strip()   
    return text


def read_plate_text(reader, cropped_plate: np.ndarray) -> str:
    ocr_results = reader.readtext(cropped_plate)
    if not ocr_results:
        return ""
    raw = " ".join(text for (_, text, _) in ocr_results)
    return clean_ocr_text(raw)



def run_inference_on_val(model, confidence_threshold: float = 0.5):
    import easyocr

    print("\nRunning inference on validation set...")
    reader = easyocr.Reader(['en'], gpu=True)

    val_dir    = Path("datasets/license_plates/images/val")
    output_dir = Path("runs/detect/output")
    output_dir.mkdir(parents=True, exist_ok=True)

    image_files = (
        list(val_dir.glob("*.jpg")) +
        list(val_dir.glob("*.jpeg")) +
        list(val_dir.glob("*.png"))
    )

    csv_rows = []

    for img_path in image_files:
        try:
            img = cv2.imread(str(img_path))
            if img is None:
                print(f"Cannot read {img_path.name}, skipping.")
                continue

            results = model(img_path, verbose=False)

            if not results or not results[0].boxes:
                print(f"  —  No plate:  {img_path.name}")
                csv_rows.append({"image": img_path.name, "plate_text": "NO_DETECTION"})
                continue

            boxes    = results[0].boxes
            confs    = boxes.conf.tolist()
            best_idx = int(np.argmax(confs))

            if confs[best_idx] < confidence_threshold:
                print(f"Low conf ({confs[best_idx]:.2f}): {img_path.name}")
                csv_rows.append({"image": img_path.name, "plate_text": "LOW_CONF"})
                continue

            x1, y1, x2, y2 = map(int, boxes.xyxy[best_idx].tolist())


            cropped_plate = img[y1:y2, x1:x2]
            plate_text    = read_plate_text(reader, cropped_plate)

            print(f"  {img_path.name}  →  [{plate_text}]  (conf {confs[best_idx]:.2f})")


            annotated = img.copy()
            cv2.rectangle(annotated, (x1, y1), (x2, y2), (0, 255, 0), 2)
            cv2.putText(
                annotated, plate_text,
                (x1, max(y1 - 10, 10)),
                cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2
            )
            cv2.imwrite(str(output_dir / img_path.name), annotated)
            csv_rows.append({"image": img_path.name, "plate_text": plate_text})

        except Exception as e:
            print(f"Error on {img_path.name}: {e}")
            csv_rows.append({"image": img_path.name, "plate_text": f"ERROR: {e}"})

    csv_path = Path("results.csv")
    with open(csv_path, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=["image", "plate_text"])
        writer.writeheader()
        writer.writerows(csv_rows)

    print(f"\nResults saved   → {csv_path}")
    print(f"Images saved    → {output_dir}/")



def test_single_image(
    image_path: str,
    model_path: str = "runs/detect/train/weights/best.pt",
    confidence_threshold: float = 0.5
):
    
    import easyocr
    from ultralytics import YOLO

    print(f"\nTesting: {image_path}")

    if not Path(model_path).exists():
        raise FileNotFoundError(
            f"Model not found at '{model_path}'.\n"
            "Run the full pipeline first to train the model."
        )

    model  = YOLO(model_path)
    reader = easyocr.Reader(['en'], gpu=True)

    img = cv2.imread(image_path)
    if img is None:
        raise FileNotFoundError(f"Image not found: {image_path}")

    results = model(image_path, verbose=False)

    if not results or not results[0].boxes:
        print("No license plate detected.")
        return

    boxes    = results[0].boxes
    best_idx = int(np.argmax(boxes.conf.tolist()))
    conf     = boxes.conf[best_idx].item()

    if conf < confidence_threshold:
        print(f"Detection confidence too low: {conf:.2f}")
        return

    x1, y1, x2, y2 = map(int, boxes.xyxy[best_idx].tolist())

    cropped_plate = img[y1:y2, x1:x2]
    plate_text    = read_plate_text(reader, cropped_plate)

    print(f"Plate detected  (conf: {conf:.2f})")
    print(f"Recognized Text: {plate_text}")

    annotated = img.copy()
    cv2.rectangle(annotated, (x1, y1), (x2, y2), (0, 255, 0), 2)
    cv2.putText(
        annotated, plate_text,
        (x1, max(y1 - 10, 10)),
        cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2
    )
    out_path = Path(image_path).stem + "_result.jpg"
    cv2.imwrite(out_path, annotated)
    print(f"Saved annotated image: {out_path}")



if __name__ == "__main__":
    print("=" * 52)
    print("   Indian License Plate Recognition System")
    print("=" * 52)


    setup_kaggle()
    download_dataset()


    prepare_dataset(split_ratio=0.8)


    model = train_model(epochs=50, imgsz=416, batch=4)


    validate_model(model)


    run_inference_on_val(model, confidence_threshold=0.5)

    print("\nPipeline complete!")
    print("   Annotated images → runs/detect/output/")
