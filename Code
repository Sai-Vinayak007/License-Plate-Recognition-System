# ── 8. OCR ON VALIDATION SET ────────────────────────────────
import easyocr
import cv2
import re
import csv
import numpy as np
from IPython.display import Image, display

CONFIDENCE_THRESHOLD = 0.5  # ✅ Filter low-confidence detections

reader = easyocr.Reader(['en'], gpu=True)


def clean_plate_text(raw_text: str) -> str:
    """Remove noise and format as Indian plate (e.g. KA 05 AB 1234)."""
    text = raw_text.upper().strip()
    text = re.sub(r'[^A-Z0-9 ]', '', text)   # keep only alphanumeric + space
    text = re.sub(r'\s+', ' ', text).strip()
    return text


def read_plate(img_bgr) -> str:
    """Run EasyOCR on a cropped plate image and return cleaned text."""
    result = reader.readtext(img_bgr)
    raw = ' '.join(text for (_, text, _) in result)
    return clean_plate_text(raw)


val_image_dir = 'datasets/license_plates/images/val'
val_image_paths = [
    os.path.join(val_image_dir, f)
    for f in os.listdir(val_image_dir)
    if f.lower().endswith(('.jpg', '.jpeg', '.png'))
]

# ✅ Save results to CSV
csv_path = 'recognition_results.csv'
csv_rows = []

print(f"\nRunning inference on {len(val_image_paths)} validation images...\n")

for img_path in val_image_paths:
    try:
        detections = model(img_path, conf=CONFIDENCE_THRESHOLD)  # ✅ conf threshold

        if detections and detections[0].boxes:
            box  = detections[0].boxes.xyxy[0].tolist()
            conf = float(detections[0].boxes.conf[0])
            x1, y1, x2, y2 = map(int, box)

            img = cv2.imread(img_path)
            if img is None:
                raise ValueError(f"Could not read image: {img_path}")

            # ✅ Crop the plate (was missing in original code)
            cropped_plate = img[y1:y2, x1:x2]

            plate_text = read_plate(cropped_plate)
            print(f"[{os.path.basename(img_path)}]  conf={conf:.2f}  → {plate_text or '(no text)'}")

            csv_rows.append({
                'image': os.path.basename(img_path),
                'confidence': round(conf, 4),
                'plate_text': plate_text,
            })

            # Draw bounding box and label on original image
            img_out = img.copy()
            cv2.rectangle(img_out, (x1, y1), (x2, y2), (0, 255, 0), 2)
            cv2.putText(img_out, plate_text, (x1, y1 - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)
            display(Image(data=cv2.imencode('.jpg', img_out)[1].tobytes()))

        else:
            print(f"[{os.path.basename(img_path)}]  No plate detected.")
            csv_rows.append({
                'image': os.path.basename(img_path),
                'confidence': 0,
                'plate_text': 'NOT DETECTED',
            })

    except Exception as e:
        print(f"[ERROR] {os.path.basename(img_path)}: {e}")

# Write CSV
with open(csv_path, 'w', newline='') as f:
    writer = csv.DictWriter(f, fieldnames=['image', 'confidence', 'plate_text'])
    writer.writeheader()
    writer.writerows(csv_rows)

print(f"\nResults saved to {csv_path}")

